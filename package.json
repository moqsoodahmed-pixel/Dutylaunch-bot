{
  "name": "dutylaunch-whatsapp-bot",
  "version": "1.0.0",
  "description": "DutyLaunch WhatsApp bot (MSG91 + Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "seed": "node scripts/seedServices.js",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "pino": "^9.4.0"
  }
}
